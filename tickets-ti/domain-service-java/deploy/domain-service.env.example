# Ejemplo de variables de entorno del domain service.
#
# El archivo REAL va en /etc/domain-service.env con permisos 600 (sudo chmod 600) y NUNCA se sube al repositorio.
# Reemplace cada marcador por su valor real en la EC2. No deje espacios alrededor del signo =.

# Clave compartida con AuthCore: debe ser idéntica al jwt.secret de /opt/login/application-prod.yml (Base64).
JWT_SECRET_BASE64=<CLAVE>

# Perfil de producción (MySQL).
SPRING_PROFILES_ACTIVE=prod

# Base MySQL propia del domain service (en el RDS, base "tickets").
DB_URL=jdbc:mysql://<ENDPOINT_RDS>:3306/tickets
DB_USER=tickets_app
DB_PASSWORD=<CLAVE>

# Puerto HTTP (opcional): application.yml usa server.port: ${PORT:8082}, así que 8082 es el valor por defecto.
PORT=8082
