# Variables que lee docker-compose.yml (copiar a tickets-ti/.env, no versionado).
# Los secretos de cada servicio (JWT_SECRET, AUTHCORE_INTERNAL_KEY, SMTP) van en
# authcore/.env y domain-service/.env.

AUTHCORE_DB_NAME=tickets_authcore
AUTHCORE_DB_USER=postgres
AUTHCORE_DB_PASSWORD=

DOMAIN_DB_NAME=tickets_domain
DOMAIN_DB_USER=postgres
DOMAIN_DB_PASSWORD=
