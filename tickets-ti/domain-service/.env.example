# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3003
NODE_ENV=development
# Proxies delante del servicio (nginx, ALB). 0 si se expone directo.
TRUST_PROXY=0

# ─── Base de datos PostgreSQL (exclusiva de domain-service) ──────────────────
# Nunca la base de authcore: los usuarios se consultan por AUTHCORE_URL.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=tickets_domain
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

# ─── JWT (mismo valor que en authcore; aquí solo se valida la firma) ─────────
JWT_SECRET=

# ─── authcore ────────────────────────────────────────────────────────────────
# En AWS: URL HTTPS pública o privada de authcore (otra cuenta, sin VPC compartida).
AUTHCORE_URL=http://localhost:8081
# Mismo valor que AUTHCORE_INTERNAL_KEY en authcore.
AUTHCORE_INTERNAL_KEY=
AUTHCORE_TIMEOUT_MS=3000

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=notificaciones@tuempresa.com
EMAIL_PASS=

# ─── CORS / Socket.io ────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
