{
  "name": "tickets-ti-domain-service",
  "version": "1.0.0",
  "description": "Servicio de tickets, SLA, asignación y notificaciones (arquitectura hexagonal)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
