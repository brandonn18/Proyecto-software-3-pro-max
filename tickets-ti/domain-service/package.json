    "supertest": "^6.3.4"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.3.2",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^6.10.1",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sanitize-html": "^2.18.0",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.4"
