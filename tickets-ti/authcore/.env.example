# Variables de authcore (Java / Spring Boot). Copiar a authcore/.env (no versionado).
# Docker Compose define DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD por su cuenta.

PORT=8081

# ─── Base de datos PostgreSQL (exclusiva de authcore) ────────────────────────
DB_HOST=localhost
DB_PORT=5433
DB_NAME=tickets_authcore
DB_USER=postgres
DB_PASSWORD=
# disable en local, require en RDS
DB_SSLMODE=disable
# Para usar MySQL en lugar de PostgreSQL define:
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/authcoredb?useSSL=false&allowPublicKeyRetrieval=true

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Compartido con domain-service, que solo valida la firma. Mínimo 32 bytes.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# 1 hora: domain-service no puede revocar tokens antes de que expiren.
JWT_EXPIRATION_MS=3600000

# ─── Comunicación interna con domain-service ─────────────────────────────────
# Clave que domain-service envía en X-Internal-Key hacia /internal/*.
# Generar igual que JWT_SECRET y usar un valor distinto (mínimo 32 caracteres).
AUTHCORE_INTERNAL_KEY=

# ─── Administrador inicial (se crea al arrancar solo si no existe) ───────────
ADMIN_USERNAME=admin
# Mínimo 8 caracteres. Vacío = no se crea ningún administrador.
ADMIN_PASSWORD=
ADMIN_EMAIL=
