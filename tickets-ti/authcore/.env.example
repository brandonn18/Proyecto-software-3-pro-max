# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3002
NODE_ENV=development
# Proxies delante del servicio (nginx, ALB). 0 si se expone directo.
TRUST_PROXY=0

# ─── Base de datos PostgreSQL (exclusiva de authcore) ────────────────────────
DB_HOST=localhost
DB_PORT=5433
DB_NAME=tickets_authcore
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Compartido con domain-service, que solo valida la firma.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Expiración corta: domain-service no consulta la blacklist de logout.
JWT_EXPIRES_IN=1h

# ─── Comunicación interna con domain-service ─────────────────────────────────
# Clave que domain-service envía en el header x-internal-key hacia /internal/*.
# Generar igual que JWT_SECRET y usar un valor distinto.
AUTHCORE_INTERNAL_KEY=

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=notificaciones@tuempresa.com
EMAIL_PASS=

# ─── CORS ────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
